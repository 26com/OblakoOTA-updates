const PUSHIK_SCENES=[[4.3,[255,255,255],[255,255,255],0],[6.2,[255,255,255],[255,255,255],1],[8.6,[80,0,150],[80,0,150],2],[14.9,[0,12,255],[0,12,255],3],[20.8,[255,255,0],[255,255,0],4],[24,[0,240,255],[0,240,255],5],[27.7,[0,240,255],[0,240,255],6],[31.7,[0,255,8],[0,255,8],7],[34.9,[235,0,100],[235,0,100],8],[38.9,[255,255,255],[255,255,255],9],[42.5,[100,0,255],[100,0,255],10],[46.3,[0,110,255],[0,110,255],11],[48.5,[0,110,255],[0,110,255],12],[50.6,[0,150,255],[0,150,255],13],[52.7,[0,150,255],[0,150,255],14],[54.4,[0,150,255],[0,150,255],15],[57.3,[0,150,255],[0,150,255],16],[61,[255,0,135],[255,0,135],17],[64.9,[255,255,255],[255,255,255],18],[70.7,[255,255,0],[255,255,0],19],[75.6,[0,240,255],[0,240,255],20],[79.5,[255,38,0],[255,38,0],21],[84.5,[255,75,0],[255,75,0],22],[87.4,[255,75,0],[255,75,0],23],[91.6,[255,75,0],[255,75,0],24]];
