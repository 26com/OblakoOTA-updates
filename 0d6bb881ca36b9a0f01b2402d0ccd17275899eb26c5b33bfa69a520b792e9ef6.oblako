function previewStorm(x,lower){
  const n=Math.max(1,state.oblakoType===2?Math.floor(state.numLeds/2):state.numLeds),i=Math.min(n-1,Math.floor(x*n));
  const j=state.oblakoType===2?(lower?n+i:n-1-i):i;
