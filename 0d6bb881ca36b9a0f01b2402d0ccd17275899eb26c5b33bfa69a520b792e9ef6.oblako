}
let previewStormActive=false,previewStormClock=0,previewStormStart=-10000,previewStormNext=1000,previewStormSeed=12345;
function updatePreviewStorm(elapsed){
  if(audioTimeline&&audioTimeline.kind==='storm_sound'){
    previewStormClock=timelineAge();const event=scheduleEvent('storm_sound',previewStormClock,audioTimeline.period);
    previewStormStart=event.id?event.start:-10000;previewStormNext=event.id?event.start+audioTimeline.period:1000;previewStormActive=true;return;
  }
  if(!previewStormActive){previewStormClock=0;previewStormStart=-10000;previewStormNext=1000;previewStormActive=true;}
  previewStormClock+=elapsed;
  if(previewStormClock>=previewStormNext){
    previewStormSeed=12345;previewStormStart=previewStormClock;
    const pause=isAudioMode(state)?8850:12000-state.speed*90;
    previewStormNext=previewStormClock+stormPulseDuration(12345,1)+250+pause;
  }
}
function previewDistantStorm(i,count,elapsed){
  const cycle=Math.floor(elapsed/2600),age=elapsed%2600;
  if(age<650||age>=950)return [0,0,1];
  let pulse=(age-650)/150;if(pulse>1)pulse=2-pulse;
