function paintPreview(){
  if(!previewOblako||!state)return;
  const selected=[state.r,state.g,state.b];
  const light=state.on?state.brightness/255:0;
  const unlit=!state.on||state.brightness===0||(audioMode()==='pushik_story'&&storySeconds()>=91.6);
  const effect=state.effect==='auto'?(state.activeEffect||'solid'):state.effect;
  const renderId=EFFECT_RENDER_IDS[AUTO_MODE_NAMES.indexOf(effect)];
  const independent=renderId>=43&&renderId<=58?renderId-43:-1;
  const flag=effect==='russian_flag';
  const storm=effect==='storm'||effect==='storm_sound';
  const building=effect==='rainbow_build';
  const story=effect==='campfire_sound'?13:STORY_RENDER_IDS.indexOf(renderId);
  const count=Math.max(2,state.oblakoType===2?Math.floor(state.numLeds/2):state.numLeds),stops=[],bottomStops=[],average=[0,0,0];
  for(let j=0;j<count;j++){
    const position=j/(count-1);
    const x=state.oblakoType===2?Math.abs(position*2-1):position;
    const n=Math.max(1,state.oblakoType===2?Math.floor(state.numLeds/2):state.numLeds);
    const i=Math.min(n-1,Math.floor(x*n));
    // White cloud base remains visible through dark parts of every preview effect.
    const effectColor=effect==='pushik_story'?previewPushik(position,storySeconds(),false):storm?previewStorm(position,false):story>=0?previewStory(story,position,story===2?previewDropletPhase:previewStoryPhase,false,j):building?previewRainbowBuild(position,false):flag?previewFlag(position,false):independent>=0?previewIndependent(independent,position,previewPhase,j, false):previewColor(effect,i/n,previewPhase,i,selected);
    const intensity=Math.max(...effectColor)/255*light;
    const color=(unlit?[255,255,255]:effect==='pushik_story'?mix([12,14,20],effectColor,light):mix([255,255,255],effectColor,Math.min(.9,intensity*.9))).map(v=>Math.max(0,Math.min(255,Math.round(v))));
    color.forEach((v,k)=>average[k]+=v/count);
    stops.push(`rgb(${color.join(',')}) ${(position*100).toFixed(3)}%`);
    if(independent>=0||storm||story>=0||flag||building||effect==='pushik_story'){
      const c=state.oblakoType===2?(effect==='pushik_story'?previewPushik(position,storySeconds(),true):storm?previewStorm(position,true):story>=0?previewStory(story,position,story===2?previewDropletPhase:previewStoryPhase,true,j):building?previewRainbowBuild(position,true):flag?previewFlag(position,true):previewIndependent(independent,position,previewPhase,j+count,true)):effectColor;
      const bottom=(unlit?[255,255,255]:effect==='pushik_story'?mix([12,14,20],c,light):mix([255,255,255],c,Math.min(.9,Math.max(...c)/255*light*.9))).map(v=>Math.round(v));
      bottomStops.push(`rgb(${bottom.join(',')}) ${(position*100).toFixed(3)}%`);
    }
  }
  const paint=(independent>=0||storm||story>=0||flag||building||effect==='pushik_story')?`linear-gradient(90deg,${stops.join(',')}) top / 100% 60% no-repeat,linear-gradient(90deg,${bottomStops.join(',')}) bottom / 100% 40% no-repeat`:`linear-gradient(90deg,${stops.join(',')})`;
  const glow=`rgb(${average.map(Math.round).join(',')})`;
  const selectedPreview=document.querySelector('.fx.active .effect-oblako');
  [previewOblako,selectedPreview].filter(Boolean).forEach(oblako=>{
    oblako.classList.toggle('preview-unlit',unlit);
    oblako.style.setProperty('--preview-paint',paint);
    oblako.style.setProperty('--preview-glow',glow);
  });
}
function animatePreview(time){
  if(state&&audioMode()==='pushik_story')renderStoryPlayer();
  const elapsed=previewLastTime?Math.min(100,time-previewLastTime):0;
  previewLastTime=time;
  if(!document.hidden&&state){
    const moving=state.on&&state.brightness>0&&state.effect!=='solid';
    const building=state.on&&(state.effect==='rainbow_build'||(state.effect==='auto'&&state.activeEffect==='rainbow_build'));
    if(building){if(!previewBuildActive)previewBuildTime=0;else previewBuildTime+=elapsed;}
    previewBuildActive=building;
    const storm=state.on&&(['storm','storm_sound'].includes(state.effect)||(state.effect==='auto'&&['storm','storm_sound'].includes(state.activeEffect)));
    if(storm)updatePreviewStorm(elapsed);else previewStormActive=false;
    if(moving){previewDropletPhase=(previewDropletPhase+elapsed*(2+Math.floor((isAudioMode(state)?soundSpeed():state.speed)*18/100))/65536)%65536;previewStoryPhase=(previewStoryPhase+elapsed*(2+Math.floor((isAudioMode(state)?soundSpeed():state.speed)*18/100))/65536)%16;previewFlagPhase=(previewFlagPhase+elapsed*(2+Math.floor((isAudioMode(state)?soundSpeed():state.speed)*18/100))/65536)%4;previewPhase=(previewPhase+elapsed*(2+Math.floor((isAudioMode(state)?soundSpeed():state.speed)*18/100))/65536)%1;}
    if(previewDirty||moving){paintPreview();previewDirty=false;}
  }
  requestAnimationFrame(animatePreview);
}

requestAnimationFrame(animatePreview);

</script><script>window.OBLAKO_SITE={"manifestUrl": "https://raw.githubusercontent.com/26com/OblakoOTA-updates/main/latest.json", "build": 1794857079};
// Runs independently of light controls: failed checks never block the device UI.
(() => {
  const {build, manifestUrl} = window.OBLAKO_SITE;
  const box = document.createElement('aside');
  box.hidden = true;
  box.style.cssText = 'position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:1000;max-width:calc(100% - 32px);width:360px;padding:16px;border:1px solid var(--line);border-radius:16px;background:var(--card);color:var(--text);box-shadow:0 4px 24px #0004';
  const button = document.createElement('button');
  button.type = 'button';button.className = 'power';button.textContent = 'Обновить версию';
  const status = document.createElement('p');
  status.style.cssText = 'margin:8px 0 0;font-size:13px';status.setAttribute('role','status');
  box.append(button,status);document.body.append(box);
  let available = null, checking = false, installing = false;

  async function timedFetch(url, options = {}, timeout = 10000) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeout);
    try {
      const response = await fetch(url, {...options, cache:'no-store', signal:controller.signal});
      if (!response.ok) throw new Error('Запрос не выполнен ('+response.status+').');
      // Consume the body under the same timeout as the request.
      return new Uint8Array(await response.arrayBuffer());
    } catch (error) {
      if (error.name === 'AbortError') throw new Error('Время ожидания истекло. Повторите попытку.');
      throw error;
    } finally { clearTimeout(timer); }
  }

  function validateManifest(data) {
    if (!data || data.api !== 2 || !Number.isSafeInteger(data.build) || data.build <= 0 || data.build > 4294967295 ||
        !Number.isSafeInteger(data.size) || data.size <= 344 || data.size > 524632 ||
        typeof data.package !== 'string' || !/^[a-f0-9]{64}\.oblako$/.test(data.package))
      throw new Error('Неподдерживаемое описание обновления.');
    const base = new URL(manifestUrl);
    if (base.protocol !== 'https:') throw new Error('Для обновлений требуется HTTPS.');
    return {...data, url:new URL(data.package, base).href};
  }

  async function check() {
    if (checking || installing || !manifestUrl) return;
    checking = true;
    try {
      const url = new URL(manifestUrl);url.searchParams.set('check', String(Date.now()));
      const bytes = await timedFetch(url.href, {credentials:'omit'});
      const next = validateManifest(JSON.parse(new TextDecoder().decode(bytes)));
      available = next.build > build ? next : null;
      box.hidden = !available;
      if (available) status.textContent = 'Доступна новая версия интерфейса.';
    } catch (_) { /* Offline/private repository: keep the current UI working. */ }
    finally { checking = false; }
  }

  button.addEventListener('click', async () => {
    if (!available || installing) return;
    installing = true;button.disabled = true;
    const next = available;
    try {
      status.textContent = 'Проверяем устройство…';
      const storage = JSON.parse(new TextDecoder().decode(await timedFetch('/site/status')));
      if (!storage.mounted) throw new Error('Хранилище недоступно. Обратитесь к разработчику устройства.');
      const installed = JSON.parse(new TextDecoder().decode(await timedFetch('/site/version')));
      if (installed.build >= next.build) { location.reload();return; }
      status.textContent = 'Скачиваем обновление…';
      const bytes = await timedFetch(next.url, {credentials:'omit'}, 60000);
      if (bytes.length !== next.size) throw new Error('Размер пакета не совпадает. Повторите загрузку.');
      // Header is checked again on the ESP8266, including its digital signature and payload hash.
      const header = new TextDecoder().decode(bytes.slice(0,88));
      if (!/^OBLSITE2[0-9a-f]{80}$/.test(header) || parseInt(header.slice(8,16),16) !== bytes.length-344 || parseInt(header.slice(16,24),16) !== next.build)
        throw new Error('Некорректный пакет сайта.');
      const prefix = new TextDecoder().decode(bytes.slice(344,456));
      if (!prefix.startsWith('<!--OBLAKO_SITE_BUILD:'+next.build+'-->\n')) throw new Error('Версия пакета не совпадает с описанием.');
      status.textContent = 'Устанавливаем обновление…';
      const form = new FormData();form.append('site',new Blob([bytes]),'site.oblako');
      await timedFetch('/site/upload',{method:'POST',body:form},120000);
      status.textContent = 'Готово. Открываем новую версию…';
      location.reload();
    } catch (error) {
      status.textContent = error.message || 'Обновление не завершено. Повторите попытку.';
    } finally { installing = false;button.disabled = false; }
  });
  window.addEventListener('pageshow',check);
  document.addEventListener('visibilitychange',()=>{if(!document.hidden)check();});
  check();
})();
</script>
</body></html>
