function previewColor(effect,x,p,i,selected){
  const w=wave(x+p),r=wave(x*2-p);
  switch(effect){
    case 'solid':return selected;
    case 'rainbow':return hsv(x+p);
    case 'aurora':return dim(gradient((w+r)/2,[8,32,65],[35,230,125],[155,65,220]),(100+wave(x-p)*127.5)/255);
    case 'ocean':return mix(gradient(w,[3,12,55],[8,90,175],[55,210,195]),[150,225,235],r*r*.249);
    case 'sunset':return gradient(w,[100,20,90],[255,80,65],[255,190,65]);
    case 'pastel':return hsv(x+p,85/255);
    case 'waves':return dim(selected,(35+w*220)/255);
    case 'waves_sound':return dim(selected,surfPreviewLight(x,waveVisualSeconds(),waveVisualVariant));
    case 'plasma':return hsv((w+r+wave(x*3+p))/3,190/255,(200+w*51)/255);
    case 'lava':return gradient((w+r)/2,[65,0,12],[220,25,3],[255,150,20]);
    case 'comet':return dim(selected,(8+Math.pow(wave(x-p),8)*247)/255);
    case 'colorflow':return hsv(p+x/4,200/255);
    case 'nebula':return dim(gradient((wave(x*3+p)+r)/2,[18,8,50],[125,55,175],[40,190,190]),(100+w*127.5)/255);
    case 'silk':return dim(mix(selected,[255,230,215],35/255),(45+wave(x*2+w*25500/65536-p)*210)/255);
    case 'moonlight':return dim(mix([12,25,70],[185,205,245],w*w),(140+r*85)/255);
    case 'embers':return gradient((wave(p+((i+1)*25717%65536)/65536)+w)/2,[28,2,0],[145,25,2],[255,125,20]);
    case 'bloom':return dim(gradient(wave(x*3+p),[65,12,55],[220,65,130],[255,195,190]),(110+r*127.5)/255);
    case 'rain':return dim(mix(selected,[190,220,255],45/255),(25+Math.pow(wave(x*4-p),4)*230)/255);
    case 'duet':{const right=wave(x-p+.5);return dim(mix(selected,selected.map(v=>255-v),right),(40+(w+right)*107.5)/255);}
    case 'lagoon':return mix(gradient(w,[4,45,65],[15,170,150],[115,235,175]),[255,225,140],Math.pow(wave(x*3-p),2)/3);
    case 'velvet':return gradient((w+r)/2,[22,3,35],[85,20,100],[185,65,120]);
    case 'dawn':return dim(gradient(w,[55,30,95],[235,110,120],[255,210,120]),(140+r*85)/255);
    case 'forest':return gradient((w+r)/2,[5,25,12],[25,110,45],[155,210,75]);
