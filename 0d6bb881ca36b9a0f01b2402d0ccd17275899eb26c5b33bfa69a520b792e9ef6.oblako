    case 'ribbon':return dim(hsv(x+p+wave(x*2-p)*255*64/65536,170/255),(100+w*127.5)/255);
    case 'tide':return dim(mix(selected,[215,245,255],Math.pow(w,4)),(50+r*205)/255);
    case 'fireflies':return mix([4,18,14],[215,235,85],Math.pow(wave(p+((i+1)*30757%65536)/65536),8));
    case 'randomdot':{const tick=Math.floor(p*64),position=Math.floor(previewNoise(tick+19)*Math.max(1,state.numLeds));return i===position?selected:[0,0,0];}
    case 'sparks':case 'randomfade':case 'colorstorm':{
      const tick=Math.floor(p*16),progress=(p*16)%1;
      const seed=tick*97+i*31;
